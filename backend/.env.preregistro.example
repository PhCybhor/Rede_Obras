# Ambiente de produção — API de Pré-Registro
ENV=production
PORT=8000

# Banco de dados (PostgreSQL recomendado em produção)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/redeobras

# Origens permitidas (domínio da landing de pré-registro)
ALLOWED_ORIGINS=https://redeobras.com.br,https://www.redeobras.com.br

# Rate limit: 5 cadastros por IP por hora
PREREGISTRO_RATE_LIMIT=5
PREREGISTRO_RATE_WINDOW=3600
