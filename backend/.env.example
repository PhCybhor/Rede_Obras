# Ambiente: development | production
ENV=development

# Banco de dados (dev: SQLite | prod: PostgreSQL, ex: postgresql://user:pass@host:5432/db)
DATABASE_URL=sqlite:///./redeobras.db

# OBRIGATÓRIO em produção. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Configuração JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Origens permitidas no CORS (separadas por vírgula, sem espaços)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@redeobras.com
SMTP_FROM_NAME=REDEOBRAS
